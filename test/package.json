{
  "name": "finally-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "FinAlly end-to-end Playwright tests (SPEC §12). Runs against the assembled app container with LLM_MOCK=true.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
